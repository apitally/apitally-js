    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "compression": "^1.8.1",
    "elysia": "^1.4.29",
    "esbuild-fix-imports-plugin": "^1.0.23",
    "express": "^5.2.1",
    "fastify": "^5.11.0",
    "h3": "2.0.1-rc.26",
    "hono": "^4.12.31",
    "knip": "^6.29.0",
    "koa": "^3.2.1",
    "koa-route": "^4.0.1",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
