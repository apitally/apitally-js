{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>apitally/renovate-config"],
  "packageRules": [
    {
      "description": "Skip runtime dependency releases that drop Node.js versions we support",
      "matchDepTypes": ["dependencies"],
      "constraintsFiltering": "strict"
    },
    {
      "matchDepTypes": ["dependencies"],
      "matchPackageNames": ["@opentelemetry/**"],
      "groupName": "OpenTelemetry"
    },
    {
      "description": "OpenTelemetry SDK 2.x packages require @opentelemetry/api <1.10.0",
      "matchPackageNames": ["@opentelemetry/api"],
      "allowedVersions": "<1.10.0"
    }
  ]
}
